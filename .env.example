# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=

# JavaFix Agent runtime defaults
JAVAFIX_WORKSPACE=shop-service
JAVAFIX_MAX_STEPS=30
JAVAFIX_COMMAND_TIMEOUT_SECONDS=120

# Local MySQL runtime configuration; keep real passwords outside Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=javafix_shop
DB_USERNAME=javafix
DB_PASSWORD=

# Automated tests use disposable Testcontainers MySQL; no test DB credentials required.
